# Server-only Backend origin, without /api/v1; never place service keys here.
# Used by Next rewrites at build time and the streaming route at runtime.
NEST_INTERNAL_API_BASE_URL=http://localhost:3000
# Docker Compose supplies this at build and runtime (http://backend:3000).
# NEXT_PUBLIC_NEST_API_BASE_URL is obsolete in the current application.

# Optional Playwright setting; if omitted the test runner starts its own server.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
