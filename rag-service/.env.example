# Canonical RAG template (the legacy .env.exmaple file is misspelled).
# Replace placeholders; never commit real credentials.
ENV=development
# Match Backend and Agent RAG_SECRET_KEY.
RAG_SECRET_KEY=replace_with_shared_rag_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_server_secret
SUPABASE_STORAGE_BUCKET=files
# Select the same 1024-dimensional model used to index the existing collection.
EMBEDDING_MODEL=replace_with_existing_1024_dimension_embedding_model
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=1024
QDRANT_URL=http://127.0.0.1:6333
# Docker: use a reachable Qdrant hostname; Compose does not supply Qdrant.
QDRANT_API_KEY=replace_with_qdrant_api_key
QDRANT_COLLECTION=replace_with_existing_collection_name
# SUPABASE_PASSWORD is not read by RAG application code.

# Optional evaluation settings: put these in .env.eval when running evaluations.
# EVAL_RAG_URL=http://127.0.0.1:8800
# EVAL_MINDSPACE_ID=00000000-0000-4000-8000-000000000001
# EVAL_OLLAMA_URL=http://127.0.0.1:11434/v1
# EVAL_MODEL=replace_with_available_evaluation_model
# Current RAG evaluation runner does not send the required service-key header.
# Setting RAG_SECRET_KEY alone does not fix that runner; code changes are separate.
