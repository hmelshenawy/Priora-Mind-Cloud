# Local development. Replace placeholders; never commit real credentials.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://replace_me:replace_me@localhost:5432/priora
JWT_SECRET=replace_with_unique_jwt_secret
JWT_EXPIRES_IN=1h
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_server_secret

# Full Agent endpoint. Docker: http://agent:8000/chat
AGENT_SERVICE_URL=http://127.0.0.1:8000/chat
# Must match Agent AGENT_SECRET_KEY; keep separate from RAG/JWT secrets.
AGENT_SECRET_KEY=replace_with_shared_agent_secret
AGENT_TIMEOUT_MS=600000
# RAG origin only; code appends /v1/ingest. Docker: http://rag:8800
RAG_URL=http://127.0.0.1:8800
# Must match Agent and RAG RAG_SECRET_KEY.
RAG_SECRET_KEY=replace_with_shared_rag_secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Production Compose overrides Redis settings; dev Compose needs reachable Redis.
# SUPABASE_PASSWORD is not read by application code; use DATABASE_URL instead.
