# Local development. Replace placeholders; never commit real credentials.
# Match Backend AGENT_SECRET_KEY.
AGENT_SECRET_KEY=replace_with_shared_agent_secret
# Match Backend and RAG RAG_SECRET_KEY; use a different secret from Agent auth.
RAG_SECRET_KEY=replace_with_shared_rag_secret
OLLAMA_MODEL_NAME=qwen3:1.7b
# Docker: use a reachable Ollama server hostname, not container loopback.
OLLAMA_HOST=http://127.0.0.1:11434
# Required for Ollama cloud web search/fetch tools.
OLLAMA_API_KEY=replace_with_ollama_api_key
# Origin only; callers append /v1/search or /v1/embed. Docker: http://rag:8800
RAG_SERVICE_URL=http://127.0.0.1:8800
# Include the Nest global prefix. Docker: http://backend:3000/api/v1
BACKEND_SERVICE_URL=http://127.0.0.1:3000/api/v1
TIMEZONE=Asia/Dubai

# Optional tracing: disabled by default; configure before opting in.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=replace_with_langsmith_api_key
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# SDK supports project routing or the paired agent identity settings.
LANGSMITH_PROJECT=priora-development
# LANGSMITH_AGENT_ID=replace_with_langsmith_agent_id
# LANGSMITH_AGENT_ENVIRONMENT=development

# Optional evaluation settings: put these in .env.eval when running evaluations.
# EVAL_JWT=replace_with_isolated_test_user_jwt
# EVAL_MINDSPACE_ID=00000000-0000-4000-8000-000000000001
# EVAL_OLLAMA_URL=http://127.0.0.1:11434/v1
# EVAL_MODEL=replace_with_available_evaluation_model
